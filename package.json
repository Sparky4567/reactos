{
  "name": "reactos-browser-clone",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "bootstrap": "^5.3.8",
    "font-awesome": "4.7.0",
    "ollama-node": "^0.1.28",
    "onnxruntime-web": "1.18.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
